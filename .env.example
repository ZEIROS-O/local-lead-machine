# LLM scoring provider chain: comma-separated subset/reordering of kimi,codex,claude,anthropic
LLM_SCORING_PROVIDER_CHAIN=kimi,codex,claude

# Provider 1 (default): kimi via Moonshot API
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_SCORING_MODEL=kimi-k3
KIMI_CONNECT_TIMEOUT_SECONDS=15
KIMI_READ_TIMEOUT_SECONDS=180
KIMI_MAX_RETRIES=2
KIMI_RETRY_BACKOFF_SECONDS=2

# Fallback 1: codex CLI (ChatGPT subscription). Fallback 2: claude CLI (subscription).
CODEX_SUBSCRIPTION_SCORING_MODEL=
CLAUDE_SUBSCRIPTION_SCORING_MODEL=
LLM_CLI_TIMEOUT_SECONDS=900

# Optional provider: anthropic via API (add to LLM_SCORING_PROVIDER_CHAIN to enable)
ANTHROPIC_API_KEY=
ANTHROPIC_CONNECT_TIMEOUT_SECONDS=15
ANTHROPIC_READ_TIMEOUT_SECONDS=180
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_RETRY_BACKOFF_SECONDS=2
MAX_LLM_CALLS_PER_RUN=5
MAX_LLM_TOKENS_PER_RUN=50000
MAX_LLM_USD_PER_RUN=5

# Ordered active setter roster. New prospects are assigned with stable
# sha256(Place Key) modulo this list; existing assignments are never rebalanced.
LPM_SETTER_ROSTER=

# Scoring v3 evidence collection (optional; all collectors fail closed)
REVIEW_SNAPSHOT_DB=run_state/review_velocity.sqlite3
MAX_NEW_DATA_USD_PER_RUN=10
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_ESTIMATED_USD_PER_REVIEW_TASK=0.20
SEMRUSH_API_TOKEN=
MAX_SEMRUSH_API_UNITS_PER_RUN=2500
GOOGLE_PAGESPEED_API_KEY=

# Compliance configuration (required for enrichment and downstream sending)
# DNC and exclusion events file (JSONL).
SUPPRESSION_SOURCE=
# Set to 1 to allow enrichment to run without a suppression file (local dev only)
ALLOW_MISSING_SUPPRESSION_INDEX=0
