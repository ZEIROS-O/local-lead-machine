# Secrets / local config
.env
.env.*
!.env.example

# Python / virtualenv
.venv/
venv/
__pycache__/
*/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Agent worktrees — a checkout inside the repo returns false hits on every
# repo-wide grep, which has already misled one review. Never commit one.
.worktrees/
.claude/worktrees/

# Machine-local Claude Code settings (the shared ones in settings.json ARE tracked)
.claude/settings.local.json

# Dashboard frontend build/install output
dashboard-ui/node_modules/
dashboard-ui/dist/
dashboard-ui/*.tsbuildinfo

# OS / editor
.DS_Store
.vscode/
.idea/

# Generated pipeline outputs
output/
cards_*/
review_queue_*/
reports/
tmp/
temp/
*.log

# Screenshots / generated artifacts
screenshots/
artifacts/
packets/
lead_packets/
packets_*/

# Archived completed runs (packets_* / review_queue_* moved off the repo root)
runs/

# Local runtime state (queue history, manual lead inbox) — never commit lead contents
run_state/
manual_leads/

# Local lead/prospect data dumps
data/
!data/
data/*
!data/manual_score_bundle.schema.json
*.csv
*.jsonl
*.xlsx
*.sqlite
*.db

# Keep intentional test fixtures
!tests/fixtures/
!tests/fixtures/**
!.gitkeep

# Sales collateral / one-off documents
.outputs/
